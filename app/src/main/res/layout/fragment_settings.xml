<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Заголовок: лого + "Настройки" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/cd_logo"
                android:src="@drawable/ic_logo_mesh"
                app:tint="@color/app_on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/settings_header"
                android:textColor="@color/app_on_surface"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Карточка 1: LoRa / Каналы / Безопасность -->
        <LinearLayout
            android:id="@+id/settings_group_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <include
                android:id="@+id/entry_lora"
                layout="@layout/item_settings_entry" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/app_outline" />

            <include
                android:id="@+id/entry_channels"
                layout="@layout/item_settings_entry" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/app_outline" />

            <include
                android:id="@+id/entry_security"
                layout="@layout/item_settings_entry" />
        </LinearLayout>

        <!-- Заголовок раздела -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_section_device"
            android:textColor="@color/app_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Карточка 2: настройки устройства -->
        <LinearLayout
            android:id="@+id/settings_group_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <include
                android:id="@+id/entry_user"
                layout="@layout/item_settings_entry" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/app_outline" />

            <include
                android:id="@+id/entry_device"
                layout="@layout/item_settings_entry" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/app_outline" />

            <include
                android:id="@+id/entry_location"
                layout="@layout/item_settings_entry" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/app_outline" />

            <include
                android:id="@+id/entry_power"
                layout="@layout/item_settings_entry" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/app_outline" />

            <include
                android:id="@+id/entry_network"
                layout="@layout/item_settings_entry" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/app_outline" />

            <include
                android:id="@+id/entry_display"
                layout="@layout/item_settings_entry" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="@color/app_outline" />

            <include
                android:id="@+id/entry_bluetooth"
                layout="@layout/item_settings_entry" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
